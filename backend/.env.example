# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=enchantmentbet

# Data mode: "auto" uses live providers when keys are present, otherwise mock.
# Force with "live" or "mock".
DATA_MODE=auto

# api-sports.io key (covers API-FOOTBALL and API-BASKETBALL)
APISPORTS_KEY=ba7120e8a0ea4eead77c474620a61186

# api-tennis.com key
APITENNIS_KEY=d046aaa1a271c1a02d737d73f4952c2cf0646c6530485aed9e23dc435d1429e7

# newsapi.org key (optional, enriches predictions with team news sentiment)
NEWSAPI_KEY=3c785159119c42068605d09c3bdc4a20

# Comma-separated origins allowed by CORS
CORS_ORIGINS=http://localhost:3000
